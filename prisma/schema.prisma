generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  DEBIT_CARD
  CASH
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
}

enum BillingCycle {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum GoalType {
  SAVINGS
  TRAVEL
  DEBT_PAYOFF
  PURCHASE
  EMERGENCY_FUND
}

enum GoalStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum GoalPriority {
  LOW
  MEDIUM
  HIGH
}

enum GoalPlanType {
  CONSERVATIVE
  BALANCED
  AGGRESSIVE
  CUSTOM
}

enum GoalMilestoneStatus {
  PENDING
  REACHED
}

enum GoalScenarioType {
  SAVINGS_RATE
  SPENDING_CUT
  INCOME_INCREASE
  CUSTOM
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  PARTIAL
}

model Account {
  id          String   @id @default(cuid())
  name        String
  type        AccountType
  bank        String?
  color       String   @default("#3B82F6")
  icon        String?
  initialBalance Float @default(0)
  isActive    Boolean  @default(true)
  openingMonth Int?
  openingYear  Int?
  sortOrder   Int      @default(0)
  // Credit-card-specific fields (nullable, only used when type === CREDIT_CARD)
  creditLimit          Float?
  closingDay           Int?
  dueDay               Int?
  lastFour             String?
  brand                String?
  creditLimitUpdatedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  statements  Statement[]
  transactions Transaction[]
  subscriptions Subscription[]
  goals       Goal[]
  goalContributions GoalContribution[]
  invoices    CreditCardInvoice[]
}

model Statement {
  id          String   @id @default(cuid())
  accountId   String
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  month       Int
  year        Int
  fileName    String
  fileUrl     String?
  uploadedAt  DateTime @default(now())
  aiCategorizedAt DateTime?
  extractedJson Json?
  transactions Transaction[]
  invoices    CreditCardInvoice[]

  @@unique([accountId, month, year])
}

model CreditCardInvoice {
  id                     String        @id @default(cuid())
  accountId              String
  account                Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  referenceMonth         Int
  referenceYear          Int
  closingDate            DateTime?
  dueDate                DateTime?
  totalAmount            Float?
  minimumPayment         Float?
  previousBalance        Float?
  paymentsReceived       Float?
  paidAmount             Float?
  creditLimitSnapshot    Float?
  availableLimitSnapshot Float?
  status                 InvoiceStatus @default(OPEN)
  paidAt                 DateTime?
  statementId            String?
  statement              Statement?    @relation(fields: [statementId], references: [id], onDelete: SetNull)
  transactions           Transaction[]
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt

  @@unique([accountId, referenceMonth, referenceYear])
  @@index([accountId])
  @@index([status])
}

model Category {
  id           String   @id @default(cuid())
  name         String
  color        String   @default("#6B7280")
  icon         String?
  parentId     String?
  parent       Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     Category[] @relation("CategoryHierarchy")
  transactions Transaction[]
  subscriptions Subscription[]
  rules        CategorizationRule[]
  goals        Goal[]
  isSystem     Boolean  @default(false)
  budget       Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@unique([name])
}

model CategorizationRule {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  keywords    String
  matchType   String   @default("contains")
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([categoryId])
}

model Transaction {
  id            String          @id @default(cuid())
  accountId     String
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  statementId   String?
  statement     Statement?      @relation(fields: [statementId], references: [id], onDelete: SetNull)
  categoryId    String?
  category      Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  type          TransactionType @default(EXPENSE)
  amount        Float
  description   String
  date          DateTime
  isRecurring   Boolean         @default(false)
  notes         String?
  installmentNumber  Int?
  installmentTotal   Int?
  installmentGroupId String?
  invoiceId     String?
  invoice       CreditCardInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  goalContributions GoalContribution[]

  @@index([accountId, date])
  @@index([categoryId])
  @@index([date])
  @@index([installmentGroupId])
  @@index([invoiceId])
}

model Subscription {
  id              String       @id @default(cuid())
  name            String
  logo            String?
  price           Float
  currency        String       @default("USD")
  billingCycle    BillingCycle @default(MONTHLY)
  frequency       Int          @default(1) // Every X days/weeks/months/years
  nextPayment     DateTime
  autoRenew       Boolean      @default(true)
  inactive        Boolean      @default(false)
  url             String?
  notes           String?
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accountId       String?
  account         Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  replacementId   String?      // ID of subscription that replaced this one

  // Auto-detection fields
  source         String    @default("manual")  // "manual" | "detected"
  matchPattern   String?                       // Normalized description used for matching
  lastSeenDate   DateTime?                     // Most recent matching transaction date
  firstSeenDate  DateTime?                     // Earliest matching transaction date
  occurrences    Int       @default(0)         // Number of matched transactions
  avgAmount      Float?                        // Average amount across matched transactions

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([nextPayment])
  @@index([inactive])
  @@index([matchPattern])
}

model Settings {
  id          String   @id @default("default")
  geminiApiKey String?
  geminiChatModel String @default("gemini-2.5-flash")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatSession {
  id        String   @id @default(cuid())
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  ChatMessage[]
  
  @@index([createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String   // "user" or "assistant"
  content   String
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}

model McpToken {
  id           String        @id @default(cuid())
  name         String
  tokenHash    String        @unique
  tokenPreview String
  permissions  String[]
  isActive     Boolean       @default(true)
  lastUsedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  auditLogs    McpAuditLog[]

  @@index([tokenHash])
  @@index([isActive])
}

model McpAuditLog {
  id         String   @id @default(cuid())
  tokenId    String
  token      McpToken @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  tool       String
  paramsJson String?
  outcome    String
  errorCode  String?
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([tokenId])
  @@index([createdAt])
}

model Goal {
  id               String       @id @default(cuid())
  name             String
  type             GoalType
  status           GoalStatus   @default(ACTIVE)
  priority         GoalPriority @default(MEDIUM)
  targetAmount     Float        @default(0)
  currentAmount    Float        @default(0)
  targetDate       DateTime?
  startDate        DateTime     @default(now())
  // Type-specific inputs (nullable, used by calculations when present)
  interestRate     Float?       // Annual interest rate (%) for debt payoff goals
  minimumPayment   Float?       // Minimum monthly payment for debt payoff goals
  monthsOfCoverage Int?         // Desired months of expenses for emergency fund goals
  metadata         Json?        // Flexible extras (e.g. travel cost breakdown)
  description      String?
  aiSummary        String?
  linkedAccountId  String?
  linkedAccount    Account?     @relation(fields: [linkedAccountId], references: [id], onDelete: SetNull)
  linkedCategoryId String?
  linkedCategory   Category?    @relation(fields: [linkedCategoryId], references: [id], onDelete: SetNull)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  plans         GoalPlan[]
  milestones    GoalMilestone[]
  contributions GoalContribution[]
  scenarios     GoalScenario[]

  @@index([status])
  @@index([type])
  @@index([linkedAccountId])
}

model GoalPlan {
  id                      String       @id @default(cuid())
  goalId                  String
  goal                    Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  planType                GoalPlanType
  monthlyTarget           Float?
  weeklyTarget            Float?
  dailyTarget             Float?
  projectedCompletionDate DateTime?
  assumptionsJson         String?
  recommendationsJson     String?
  createdBy               String       @default("system") // "system" | "ai" | "user"
  createdAt               DateTime     @default(now())

  @@index([goalId])
}

model GoalMilestone {
  id           String              @id @default(cuid())
  goalId       String
  goal         Goal                @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title        String
  targetAmount Float
  targetDate   DateTime?
  status       GoalMilestoneStatus @default(PENDING)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([goalId])
}

model GoalContribution {
  id            String       @id @default(cuid())
  goalId        String
  goal          Goal         @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount        Float
  date          DateTime     @default(now())
  accountId     String?
  account       Account?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transactionId String?
  transaction   Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  note          String?
  createdAt     DateTime     @default(now())

  @@index([goalId])
  @@index([accountId])
}

model GoalScenario {
  id                 String           @id @default(cuid())
  goalId             String
  goal               Goal             @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title              String
  scenarioType       GoalScenarioType
  monthlySavings     Float?
  spendingCutsJson   String?
  incomeIncreaseJson String?
  projectedResult    String?
  riskLevel          String?
  aiExplanation      String?
  createdAt          DateTime         @default(now())

  @@index([goalId])
}

model ApiLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  level      String   @default("INFO") // INFO | WARN | ERROR
  category   String   @default("api")  // api | statement_parse | ai_call
  method     String?
  path       String?
  status     Int?
  durationMs Int?
  message    String?
  metadata   Json?
  error      String?
  userEmail  String?

  @@index([createdAt])
  @@index([level])
  @@index([category])
  @@index([path])
}

// ---- Financial Journey Memory System ----
// Discriminator fields (entryType, source, memoryType, status, relationshipType,
// entityType) are stored as validated Strings rather than Prisma enums: the spec
// uses snake_case values, there are several evolving sets, and the codebase
// already uses Strings for similar discriminators (subscription.source, chat
// role, audit outcome). Allowed values live in src/lib/memory/types.ts.
//
// Cross-entity references (relatedGoalId, relatedEntityId, sourceSessionId, etc.)
// are plain String ids without foreign keys on purpose: memory is durable and
// must survive deletion of the entity it describes ("archived or superseded, not
// deleted").

model FinancialJourney {
  id           String         @id @default(cuid())
  title        String         @default("My Financial Journey")
  status       String         @default("active") // active | archived
  summary      String?
  currentFocus String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  entries      JourneyEntry[]
}

model JourneyEntry {
  id                   String           @id @default(cuid())
  journeyId            String
  journey              FinancialJourney @relation(fields: [journeyId], references: [id], onDelete: Cascade)
  entryType            String
  title                String
  summary              String?
  source               String           @default("manual")
  sourceSessionId      String?
  relatedGoalId        String?
  relatedPlanId        String?
  relatedTransactionId String?
  relatedAccountId     String?
  importance           String           @default("medium") // low | medium | high
  confidence           Float?
  tags                 String[]         @default([])
  happenedAt           DateTime         @default(now())
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([journeyId])
  @@index([entryType])
  @@index([happenedAt])
}

model ConversationMemory {
  id                    String   @id @default(cuid())
  sessionId             String
  source                String   @default("chat")
  title                 String?
  rawSummary            String?
  structuredSummaryJson String?
  keyDecisionsJson      String?
  assumptionsJson       String?
  nextStepsJson         String?
  relatedGoalIds        String[] @default([])
  relatedPlanIds        String[] @default([])
  createdAt             DateTime @default(now())

  @@index([sessionId])
}

model FinancialMemory {
  id                String            @id @default(cuid())
  memoryType        String
  title             String
  content           String
  normalizedContent String?
  status            String            @default("active") // active | archived | superseded | rejected | needs_review
  source            String            @default("manual")
  sourceSessionId   String?
  relatedEntityType String?
  relatedEntityId   String?
  confidence        Float?
  priority          Int               @default(0)
  validFrom         DateTime          @default(now())
  validUntil        DateTime?
  supersededById    String?
  supersededBy      FinancialMemory?  @relation("MemorySupersede", fields: [supersededById], references: [id], onDelete: SetNull)
  supersedes        FinancialMemory[] @relation("MemorySupersede")
  links             MemoryLink[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([memoryType])
  @@index([status])
  @@index([relatedEntityType, relatedEntityId])
}

model MemoryLink {
  id               String          @id @default(cuid())
  memoryId         String
  memory           FinancialMemory @relation(fields: [memoryId], references: [id], onDelete: Cascade)
  entityType       String
  entityId         String
  relationshipType String          @default("relates_to")
  createdAt        DateTime        @default(now())

  @@index([memoryId])
  @@index([entityType, entityId])
}

model MemoryReviewQueue {
  id                     String    @id @default(cuid())
  proposedMemoryType     String
  title                  String
  content                String
  extractedFromSessionId String?
  confidence             Float?
  status                 String    @default("pending") // pending | approved | rejected | edited
  createdAt              DateTime  @default(now())
  reviewedAt             DateTime?

  @@index([status])
}
